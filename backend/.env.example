# Copy to backend/.env for local development. Never commit the real .env.

# Leave empty to use a local SQLite file (no setup). For PostgreSQL:
# DATABASE_URL=postgresql://postgres:<your-password>@localhost:5432/study_platform
DATABASE_URL=

# Any long random text. Signs the login tokens.
SECRET_KEY=

# First admin account (created on first start)
ADMIN_EMAIL=admin@studymatch.lk
ADMIN_PASSWORD=

# true = add demo students on an empty database
SEED_DEMO=true

# Address of the website (used in password-reset emails)
FRONTEND_URL=http://localhost:5173

# Mailtrap / SMTP login for reset emails (optional - without it the link is printed in the server log)
SMTP_USER=
SMTP_PASSWORD=
