# Copy to backend/.env for local development. Never commit the real .env.
# A blank value keeps the default described above it.

# Blank = local SQLite file backend/studymatch.db (no setup). For PostgreSQL:
# DATABASE_URL=postgresql://postgres:<your-password>@localhost:5432/study_platform
DATABASE_URL=

# Any long random text. Signs the login tokens. Blank = new random key each start (everyone signed out on restart).
SECRET_KEY=

# Admin account, created on first start. Blank password + SEED_DEMO=true = Admin@1234 (local only).
ADMIN_EMAIL=admin@studymatch.lk
ADMIN_PASSWORD=

# true = add demo students, groups and ratings on an empty database
SEED_DEMO=true

# Address of the website
FRONTEND_URL=http://localhost:5173

# Email codes (sign-up and password reset). Leave SMTP_USER blank to run without email:
# new accounts are confirmed straight away and reset codes are printed in the server window.
# Gmail: SMTP_USER = the Gmail address, SMTP_PASSWORD = a Google "app password" (not the Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_NAME=StudyMatch AI
EMAILS_FROM_EMAIL=
